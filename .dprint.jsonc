{
  "newLineKind": "lf",
  "toml": { "comment.forceLeadingSpace": false },
  "exec": {
    "cwd": "${configDir}",
    "commands": [{
      "command": "golangci-lint fmt --stdin",
      "exts": ["go"],
      "cacheKeyFiles": [".golangci.yaml"],
    }],
  },
  "excludes": ["**/integration/testdata/**", "CLAUDE.md"],
  "plugins": [
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "https://plugins.dprint.dev/kjanat/shfmt-1.1.0.wasm",
    "npm:@dprint/markdown@0.23.2",
    "npm:@dprint/toml@0.8.0",
  ],
}
